tn5250_require_jobs() {
    if [ -z "${TN5250_JOBS:-}" ]; then
        if command -v nproc >/dev/null 2>&1; then
            TN5250_JOBS=$(nproc 2>/dev/null || printf '%s\n' 4)
        else
            TN5250_JOBS=4
        fi
    fi
    case "${TN5250_JOBS}" in
        ''|*[!0-9]*|0*)
            out_die "--jobs must be a positive integer."
            ;;
    esac
}

tn5250_cache_root() {
    printf '%s\n' "${XDG_CACHE_HOME:-${HOME}/.cache}/tn5250"
}

tn5250_fetch_source() {
    local _src=$1
    mkdir -p "$(dirname "${_src}")" || out_die "Cannot create the source cache."
    if [ ! -d "${_src}/.git" ]; then
        out_info "Cloning tn5250 ${TN5250_REF}"
        git clone --depth 1 --branch "${TN5250_REF}" "${TN5250_REPO}" "${_src}" || out_die "git clone failed."
    else
        out_info "Updating tn5250 checkout to ${TN5250_REF}"
        git -C "${_src}" fetch --depth 1 origin "${TN5250_REF}" || out_die "git fetch failed."
        git -C "${_src}" checkout --force --detach FETCH_HEAD || out_die "git checkout failed."
    fi
}

tn5250_install_cli() {
    local _dest_dir="${TN5250_PREFIX}/bin"
    mkdir -p "${_dest_dir}" || out_die "Cannot create ${_dest_dir}."
    local _src=$(tn5250_self_path)
    local _dest="${_dest_dir}/${APP_NAME}"
    local _current=""
    if [ -e "${_dest}" ] && command -v readlink >/dev/null 2>&1; then
        _current=$(readlink -f "${_dest}" 2>/dev/null || printf '%s' "")
    fi
    if [ "${_src}" != "${_current}" ]; then
        cp -f "${_src}" "${_dest}" || out_die "Cannot copy ${APP_NAME} into the prefix."
    fi
    chmod +x "${_dest}" || out_die "Cannot mark ${APP_NAME} executable."
    local _app=$(tn5250_app_dir)
    case ":${PATH}:" in
        *":${_dest_dir}:"*":${_app}:"*| *":${_app}:"*":${_dest_dir}:"*) ;;
        *)
            local _bashrc="${HOME}/.bashrc"
            local _marker="# >>> tn5250 >>>"
            touch "${_bashrc}" || out_die "Cannot update the bashrc PATH marker."
            if ! grep -F -q "${_marker}" "${_bashrc}"; then
                printf '\n%s\nexport PATH="%s:%s:$PATH"\n# <<< tn5250 <<<\n' \
                    "${_marker}" "${_app}" "${_dest_dir}" >> "${_bashrc}"
                out_info "Added ${_app} to ~/.bashrc. Open a new shell, then run: tn5250 HOST"
            fi
            ;;
    esac
}

