# =============================================================================
# tn5250_connect_fix_stamp() - Identity of the connect fix
# =============================================================================
#
# GENERAL PURPOSE:
# Returns the stamp written next to a client built with the connect fix.
# A payload without this stamp is rebuilt. The stamp is not a git commit.
#
# Last updated: 2026-10-07
# =============================================================================

tn5250_connect_fix_stamp() {
    printf '%s\n' "addrinfo-1"
}

# =============================================================================
# tn5250_payload_has_connect_fix() - Whether the installed client has the fix
# =============================================================================
#
# GENERAL PURPOSE:
# Returns 0 when CONNECT-FIX in the application directory matches the stamp.
#
# Last updated: 2026-10-07
# =============================================================================

tn5250_payload_has_connect_fix() {
    local _dir=$(tn5250_app_dir)
    local _have=""
    [ -f "${_dir}/CONNECT-FIX" ] || return 1
    IFS= read -r _have < "${_dir}/CONNECT-FIX" || return 1
    [ "${_have}" = "$(tn5250_connect_fix_stamp)" ]
}

# =============================================================================
# tn5250_write_connect_fix() - Record the connect fix next to the programs
# =============================================================================
#
# GENERAL PURPOSE:
# Writes CONNECT-FIX so a later setup can skip the compile.
#
# Last updated: 2026-10-07
# =============================================================================

tn5250_write_connect_fix() {
    local _dir=$1
    printf '%s\n' "$(tn5250_connect_fix_stamp)" > "${_dir}/CONNECT-FIX" \
        || out_die "Cannot record the connect fix."
}

# =============================================================================
# tn5250_apply_connect_fix() - Do not free an undefined addrinfo
# =============================================================================
#
# GENERAL PURPOSE:
# Upstream v0.18.0 leaves struct addrinfo *result uninitialized. When
# getaddrinfo fails, POSIX leaves that pointer undefined, and the client
# calls freeaddrinfo on it. That is the segmentation fault on a host token.
# The same block exists in telnetstr.c and sslstream.c. This patch
# initializes the pointer and does not free it on failure. HEAD stays the
# upstream commit. This is not the Windows GCC 14 patch.
#
# Last updated: 2026-10-07
# =============================================================================

tn5250_apply_connect_fix() {
    local _src=$1
    local _patch=$(mktemp) || out_die "Cannot create a patch file."
    cat > "${_patch}" <<'EOF'
diff --git a/lib5250/telnetstr.c b/lib5250/telnetstr.c
