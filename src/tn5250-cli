: "${TN5250_REPO:=https://github.com/tn5250/tn5250.git}"
: "${TN5250_REF_DEFAULT:=v0.18.0}"

tn5250_os_field() {
    local _key="$1"
    [ -r /etc/os-release ] || return 0
    local _val=$(sed -n "s/^${_key}=//p" /etc/os-release | head -n 1)
    _val=$(printf '%s' "${_val}" | tr -d '"' | tr -d "'")
    printf '%s' "${_val}"
}

tn5250_detect_platform() {
    case "${OSTYPE:-}" in
        msys*|mingw*)
            case "$(uname -s 2>/dev/null || true)" in
                MINGW*|MSYS*)
                    printf '%s\n' windows
                    return 0
                    ;;
            esac
            ;;
    esac
    local _id=$(tn5250_os_field ID)
    local _ver=$(tn5250_os_field VERSION_ID)
    local _code=$(tn5250_os_field VERSION_CODENAME)
    if [ -n "${TERMUX_VERSION:-}" ]; then
        printf '%s\n' termux
        return 0
    fi
    if [ "${_id}" = "debian" ]; then
        if [ "${_ver}" = "12" ] && [ "${_code}" = "bookworm" ]; then
            printf '%s\n' debian
            return 0
        fi
        if [ "${_ver}" = "13" ] && [ "${_code}" = "trixie" ]; then
            printf '%s\n' debian
            return 0
        fi
        if [ "${_ver}" = "12" ] || [ "${_ver}" = "13" ] || [ "${_code}" = "bookworm" ] || [ "${_code}" = "trixie" ]; then
            printf '%s\n' debian-mismatch
            return 0
        fi
    fi
    if [ "${_id}" = "ubuntu" ]; then
        if [ "${_ver}" = "22.04" ] && [ "${_code}" = "jammy" ]; then
            printf '%s\n' ubuntu
            return 0
        fi
        if [ "${_ver}" = "24.04" ] && [ "${_code}" = "noble" ]; then
            printf '%s\n' ubuntu
            return 0
        fi
        if [ "${_ver}" = "26.04" ] && [ "${_code}" = "resolute" ]; then
            printf '%s\n' ubuntu
            return 0
        fi
        if [ "${_ver}" = "22.04" ] || [ "${_ver}" = "24.04" ] || [ "${_ver}" = "26.04" ] || [ "${_code}" = "jammy" ] || [ "${_code}" = "noble" ] || [ "${_code}" = "resolute" ]; then
            printf '%s\n' ubuntu-mismatch
            return 0
        fi
    fi
    case "$(uname -s 2>/dev/null || true)" in
        Linux)
            printf '%s\n' other-linux
            return 0
            ;;
    esac
    printf '%s\n' other
}

tn5250_self_path() {
    local _src=$0
    case "${_src}" in
        */*) ;;
        *)
            _src=$(command -v -- "${_src}") || out_die "Cannot locate this script on PATH."
            ;;
    esac
    if command -v readlink >/dev/null 2>&1; then
        readlink -f "${_src}" 2>/dev/null || printf '%s\n' "${_src}"
    else
        printf '%s\n' "${_src}"
    fi
}

tn5250_app_dir() {
    if [ -n "${TN5250_APP_DIR:-}" ]; then
        printf '%s\n' "${TN5250_APP_DIR}"
        return 0
    fi
    local _here=$(CDPATH= cd "$(dirname "$(tn5250_self_path)")" && pwd)
    if [ -f "${_here}/../opt/tn5250/tn5250.exe" ] || [ -f "${_here}/../opt/tn5250/tn5250" ] || [ -d "${_here}/../opt/tn5250" ]; then
        (CDPATH= cd "${_here}/../opt/tn5250" && pwd)
        return 0
    fi
    printf '%s\n' "${TN5250_PREFIX:-${HOME}/.local}/opt/tn5250"
}

tn5250_payload_ref() {
    local _dir=$(tn5250_app_dir)
    if [ -f "${_dir}/REF" ]; then
        IFS= read -r _line < "${_dir}/REF" || _line=""
        printf '%s\n' "${_line}"
    else
        printf '%s\n' "not installed"
    fi
}

tn5250_payload_rev() {
    local _dir=$(tn5250_app_dir)
    if [ -f "${_dir}/REVISION" ]; then
        IFS= read -r _line < "${_dir}/REVISION" || _line=""
        printf '%s\n' "${_line}"
    else
        printf '%s\n' "not installed"
    fi
}

tn5250_print_payload_version() {
    local _ref=$(tn5250_payload_ref)
    local _rev=$(tn5250_payload_rev)
    if [ "${_ref}" = "not installed" ] || [ "${_rev}" = "not installed" ]; then
        out_warn "tn5250 payload is not installed. Run: ${APP_NAME} setup"
    else
        out_info "tn5250 ${_ref} (${_rev})"
    fi
}

tn5250_about_human() {
    out_info "Payload platform:  $(tn5250_detect_platform)"
    out_info "Payload ref:       $(tn5250_payload_ref)"
    out_info "Payload revision:  $(tn5250_payload_rev)"
    out_info "Payload directory: $(tn5250_app_dir)"
}

tn5250_setup_help() {
    out_info "${APP_NAME} setup — build the upstream TN5250 client"
    out_plain "  ${APP_NAME} setup [options]"
    out_plain "  ${APP_NAME} HOST [arguments]"
    out_empty_line
    out_plain "Git Bash builds the Windows programs."
    out_plain "Debian 12 and 13, Ubuntu 22.04, 24.04, and 26.04, and other Linux build the curses program."
    out_plain "setup is the same command for your user and for a sudo launch."
    out_plain "Missing compiler packages are installed with sudo from inside setup."
