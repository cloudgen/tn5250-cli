# =============================================================================
# app_help() - Display help for tn5250-cli
# =============================================================================
#
# Shows usage, available commands, and global flags.
# Fully respects --quiet and --json modes.
#
# In --json mode: returns a minimal success object instead of long text.
# In --quiet mode: prints nothing (silent).
#
# Keep in sync with requirement-shell-cli-interface.md command table.
#
# Last updated: 2026-10-07
# =============================================================================

app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Shell script bootstrap for self Installation & Maintenance}}"
    : "${DESCRIPTION:=POSIX /bin/sh program: install, version-check, self-update, self-uninstall, and about, plus setup and host launch for the TN5250 client. A terminal with no command opens the numbered list. A pipe, --quiet, or --json places this CLI.}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, version-check, install, self-update, self-uninstall."
        return 0
    fi

    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line

    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_plain "  ${APP_NAME}                  Terminal: numbered list. Pipe, --quiet, or --json: place this CLI"
    out_empty_line

    out_info "Self-Management (Type 0 - any user):"
    out_plain "  install              Install ${APP_NAME} (root→global, user→~/.local/bin)"
    out_plain "  self-install         Place this CLI the same way as install"
    out_plain "  menu, main           Open the numbered list. Needs a terminal"
    out_plain "  version              Show current version"
    out_plain "  about                Show detailed diagnostics"
    out_plain "  version-check        Compare local vs remote version (needs SCRIPT_URL)"
    out_plain "  self-update          Update ${APP_NAME} to a newer remote version"
    out_plain "  self-uninstall       Remove ${APP_NAME} (safe PATH cleanup)"
    out_plain "  help                 Show this help"
    out_empty_line

    # --- DOMAIN_HELP_ROWS (specializee injection) ---
    out_info "Domain (TN5250 client):"
    out_plain "  setup                Build the upstream client for Git Bash or Debian 12/13"
    out_plain "  setup -h             Show setup flags before any platform check"
    out_plain "  HOST                 Any other non-flag word launches the built tn5250"
    out_plain "  --version, -V        Same as version (CLI version and payload ref)"
    out_plain "  -h, --help           Same as help"
    out_empty_line
    out_plain "  The installed program is the upstream client. This installer remains ${APP_NAME}."
    out_empty_line
    # --- end DOMAIN_HELP_ROWS ---

    out_info "Global Options:"
    out_plain "  --quiet, -q          Suppress info/success (errors and warnings still shown)"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Force reinstall / skip uninstall confirm / allow downgrade"
    out_plain "  --debug              Debug diagnostics on stderr"
    out_empty_line

    # Effective channel values (Config SSOT / env override) so help is actionable.
    # CHECKSUM is an install-path runtime pin only — never listed here (requirement-shell-automatic-checksum).
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=tn5250-cli}"
    : "${SCRIPT_URL:=}"

    out_info "Environment:"
    out_plain "  REPO_USER            ${REPO_USER}"
    out_plain "                       GitHub owner used to compose default SCRIPT_URL"
    out_plain "  REPO_NAME            ${REPO_NAME}"
    out_plain "                       GitHub repo used to compose default SCRIPT_URL"
    if [ -n "${SCRIPT_URL}" ]; then
        out_plain "  SCRIPT_URL           ${SCRIPT_URL}"
    else
        out_plain "  SCRIPT_URL           (not set)"
    fi
    out_plain "                       Canonical install channel (override via env; needed for version-check/self-update)"
    out_empty_line
}


# =============================================================================
# app_menu_read_choice() - Read one menu choice in the current shell
# =============================================================================
#
# GENERAL PURPOSE:
# Prints the choose prompt and reads one line into PROMPT_ASK_VALUE.
# Call this in the current shell. Do not wrap it in $() or backticks.
# A failed read (EOF) returns 1. An empty line is a successful empty value.
#
# WARNING — do-not-capture-read: the body contains read.
#
# Last updated: 2026-10-07
# =============================================================================

app_menu_read_choice() {
    : "${PROMPT_ASK_VALUE:=}"
    out_msg_n "Choose a number, or type the command name: "
    PROMPT_ASK_VALUE=""
    if ! read -r PROMPT_ASK_VALUE; then
        return 1
    fi
    return 0
}

# =============================================================================
# app_menu_draw_front() - Front board of the numbered list
# =============================================================================
#
# GENERAL PURPOSE:
# Prints the front board. Row 1 is the setup verb. This program has no
# server commands. A host name stays on the command line. Self-management
# is row 8.
#
# Last updated: 2026-10-08
# =============================================================================

app_menu_draw_front() {
    : "${APP_NAME:=tn5250-cli}"
    out_info "$(util_app_ident) — numbered list of live commands"
    out_plain "This program has no server commands."
    out_plain "Open a host on the command line: ${APP_NAME} HOST."
    out_menu_choice "1" "setup" "Build the upstream TN5250 client"
    out_menu_choice "8" "self-management" "Place, check, update, or remove this CLI"
    out_plain "9. Exit"
}

# =============================================================================
# app_menu_draw_self() - Self-management board under row 8
# =============================================================================
#
# GENERAL PURPOSE:
# Prints rows 82 through 87. Row 81 is not printed: this list does not
# place a payload. Row 82 runs about when chosen.
#
# Last updated: 2026-10-07
# =============================================================================

app_menu_draw_self() {
    : "${APP_NAME:=tn5250-cli}"
    out_info "$(util_app_ident) — self-management"
    out_plain "This list does not place a payload. Next: ${APP_NAME} setup."
    out_menu_choice "82" "version" "Show current version"
    out_menu_choice "83" "about" "Show detailed diagnostics"
    out_menu_choice "84" "version-check" "Compare local vs remote version (needs SCRIPT_URL)"
    out_menu_choice "85" "self-update" "Update ${APP_NAME} to a newer remote version"
    out_menu_choice "86" "self-uninstall" "Remove ${APP_NAME} (safe PATH cleanup)"
    out_menu_choice "87" "self-install" "Place this CLI the same way as install"
    out_plain "0. Back"
}

# =============================================================================
# app_cmd_menu_self() - Self-management menu layer
# =============================================================================
#
# GENERAL PURPOSE:
# Owns the self-management list. A valid leaf returns so the front board
# is shown again. Back, an empty line, or EOF returns to the front board
# without running a command. A wrong pick reprints this list.
#
# Last updated: 2026-10-07
# =============================================================================

app_cmd_menu_self() {
    local _choice=""
    while true; do
        app_menu_draw_self
        if ! app_menu_read_choice; then
            return 0
        fi
        _choice="${PROMPT_ASK_VALUE}"
        case "${_choice}" in
            ""|0|q|back|exit|quit)
                return 0
                ;;
            82|version|83|about)
                app_about
                return 0
                ;;
            84|version-check)
                ver_check
                return 0
                ;;
            85|self-update)
                inst_self_update
                return 0
                ;;
            86|self-uninstall)
                inst_self_uninstall
                return 0
                ;;
            87|self-install|install)
                inst_perform_install
                return 0
                ;;
            *)
                out_error "${_choice} is not on this list."
                ;;
        esac
    done
}

# =============================================================================
# app_cmd_menu() - Front board of the numbered list
# =============================================================================
#
# GENERAL PURPOSE:
# Opens the numbered list on a terminal. Off a terminal it stops.
# Interactive use ignores --json and --quiet while the list is open.
# An empty line on this board leaves. Exit is 9.
#
# Last updated: 2026-10-08
# =============================================================================

app_cmd_menu() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    : "${APP_NAME:=tn5250-cli}"
    if [ "${TTY}" -ne 1 ]; then
        out_die "menu needs a terminal. Next: ${APP_NAME} help"
    fi
    _menu_json="${JSON}"
    _menu_quiet="${QUIET}"
    JSON=0
    QUIET=0
    while true; do
        app_menu_draw_front
        if ! app_menu_read_choice; then
            JSON="${_menu_json}"
            QUIET="${_menu_quiet}"
            unset _menu_json _menu_quiet
            return 0
        fi
        _choice="${PROMPT_ASK_VALUE}"
        case "${_choice}" in
            ""|9|exit|quit|q)
                JSON="${_menu_json}"
                QUIET="${_menu_quiet}"
                unset _menu_json _menu_quiet _choice
                return 0
                ;;
            1|setup)
                tn5250_setup
                ;;
            8|self-management)
                app_cmd_menu_self
                ;;
            *)
                out_error "${_choice} is not on this list."
                ;;
        esac
    done
}

# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Thin dispatcher for the tn5250-cli CLI (Type 0 only).
# Handles:
#   - Auto-install behavior for classic `curl | sh` one-liner (zero arguments)
#   - Global flag parsing (--quiet, --json, --debug, --force)
#   - Command routing for all Type 0 self-management commands
#
# This is the single entry point when the script is executed directly.
#
# CIAO PRINCIPLES APPLIED:
# - Caution (Principle 1): Never call undefined functions. Always use inst_is_installed.
#   Auto-install block is kept at the very top as required by existing comments.
# - Intentional (Principle 2): All supported commands from
#   requirement-shell-cli-interface.md and app_help() are recognized and routed.
# - Anti-fragile (Principle 3): Works correctly in interactive TTY, quiet, JSON,
#   and non-interactive `curl | sh` environments.
# - Over-protect (Principle 18): Explicit if/then logic, safe defaults, and centralized
#   output via out_die for unknown commands.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is the central command dispatcher. Changes here affect every execution path.
#
# Lessons Learned (CIAO Reflection):
# 2026-06-26:
#   - Original version called non-existent functions and only recognized
#     version/about/help; expanded routing and safe defaults.
# 2026-07-12:
#   - Wired --force → FORCE=1 and FORCE_REINSTALL=1 (requirement-shell-cli-interface).
# 2026-07-14:
#   - version routes through app_version (no dual inline path).
#   - zero-arg install propagates failure exit status.
#   - Type O empty argv: always install-ensure (not help when already installed).
#     Cases A/B/C (not installed / local / global). --force only for deliberate
#     re-download/replace — not required for a second one-liner run.
#     SSOT: requirement-shell-cli-zero-arguments.md (tn5250-cli = Type O).
# 2026-08-11:
#   - Specializee injection anchors (DOMAIN_DISPATCH_*) for A→B products; empty
#     argv remains Type O — domain setup uses explicit verbs only.
# 2026-10-07:
#   - No command after flag parse is empty argv. --debug, --quiet, --json, and
#     --force with no command stay on that path.
#   - Non-interactive empty argv (no TTY, or quiet, or json) runs self-install
#     (inst_perform_install). It does not open the menu and does not print help.
#   - Interactive empty argv opens app_cmd_menu.
#   - menu and main are that same list. Off a terminal they stop.
# 2026-10-08:
#   - Front board row 1 is setup. Choosing 1 or typing setup calls
#     tn5250_setup. After it returns, the front board is shown again.
#
# Last updated: 2026-10-08
# =============================================================================

app_main() {
    # --- Safe Variable Defaults ---
    COMMAND=""
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"

    # Effective scratch/cache root for this run (requirement-shell-cli-storage).
    # Priority: /dev/shm → /tmp → STORAGE_DIR (persistent cache fallback).
    # Resolver creates root fail-closed. Export TMPDIR so mktemp -t (install
    # download stage) lands under the isolated product root.
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # === Argument parsing: flags and commands (order-independent) ===
    # Empty argv is decided AFTER this parse. A switch with no command is still
    # empty argv. A host token is not.
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            # --- DOMAIN_DISPATCH_FLAGS (specializee injection) ---
            -h|--help)
                COMMAND="help"
                ;;
            --version|-V)
                COMMAND="version"
                ;;
            # --- end DOMAIN_DISPATCH_FLAGS ---
            version|about|help|version-check|self-update|self-uninstall|install|self-install|menu|main)
                COMMAND="$1"
                ;;
            # --- DOMAIN_DISPATCH_COMMANDS (specializee injection) ---
            setup)
                COMMAND="setup"
                shift
                break
                ;;
            # --- end DOMAIN_DISPATCH_COMMANDS ---
            *)
                case "$1" in
                    --*|-*)
                        out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                        ;;
                esac
                COMMAND="launch"
                TN5250_HOST=$1
                shift
                break
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE}"

    # No command after flag parse.
    # Non-interactive (no TTY, or --quiet, or --json) places the CLI.
    # Interactive opens the numbered list. Neither path starts setup.
    # SSOT: requirement-shell-cli-zero-arguments.md
    #       requirement-shell-cli-default-interaction.md
    if [ -z "${COMMAND}" ]; then
        if [ "${TTY}" -ne 1 ] || [ "${QUIET}" -eq 1 ] || [ "${JSON}" -eq 1 ]; then
            inst_perform_install
            exit $?
        fi
        app_cmd_menu
        exit $?
    fi

    case "${COMMAND}" in
        version)
            app_version
            ;;
        about)
            app_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall)
            inst_self_uninstall
            ;;
        install|self-install)
            inst_perform_install
            ;;
        menu|main)
            app_cmd_menu
            ;;
        # --- DOMAIN_DISPATCH_ROUTES (specializee injection) ---
        setup)
            tn5250_setup "$@"
            ;;
        launch)
            tn5250_launch "${TN5250_HOST}" "$@"
            ;;
        # --- end DOMAIN_DISPATCH_ROUTES ---
        help|*)
            app_help
            ;;
    esac
}


# =============================================================================
# BOOTSTRAP
# =============================================================================
#
# Always invoke the single dispatcher. Do NOT gate on ${0##*/} matching APP_NAME:
# under curl | sh / stdin pipe, $0 is the shell (sh/bash/…), not the product
# filename — a basename gate causes silent no-op and breaks one-liner install.
# Product law: requirement-shell-cli-zero-arguments.md (non-interactive empty argv
# is self-install) + requirement-shell-cli-default-interaction.md (interactive
# empty argv is the numbered list) + requirement-shell-cli-interface.md
# (single app_main entry). Historical: INC-20260712-001.
#
# Single-file install CLI: source-as-library is unsupported; main always runs.
# =============================================================================
app_main "$@"

# End of tn5250-cli - Type 0 self-management plus TN5250 domain
