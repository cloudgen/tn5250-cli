tn5250_msys2_bash() {
    local _root=$1
    local _body=$2
    local _dir=$(mktemp -d) || out_die "Cannot create a temporary directory."
    local _script="${_dir}/run.sh"
    local _runner="${_dir}/run.cmd"
    printf '%s\n' "${_body}" > "${_script}"
    local _bash_win=$(cygpath -w "${_root}/usr/bin/bash.exe")
    local _script_win=$(cygpath -w "${_script}")
    printf '@echo off\r\nset MSYSTEM=\r\nset CHERE_INVOKING=\r\n"%s" --login "%s"\r\n' \
        "${_bash_win}" "${_script_win}" > "${_runner}"
    local _rc=0
    cmd.exe //c "${_runner}" || _rc=$?
    rm -rf "${_dir}"
    return "${_rc}"
}

tn5250_find_msys2() {
    if [ -n "${TN5250_MSYS2_ROOT:-}" ]; then
        TN5250_MSYS2_ROOT=$(cygpath -u "${TN5250_MSYS2_ROOT}")
        [ -x "${TN5250_MSYS2_ROOT}/usr/bin/bash.exe" ] || out_die "MSYS2 bash not found at ${TN5250_MSYS2_ROOT}"
        return 0
    fi
    local _candidate
    for _candidate in \
        "${HOME}/.local/opt/msys64" \
        "/c/msys64" \
        "/c/tools/msys64"
    do
        if [ -x "${_candidate}/usr/bin/bash.exe" ]; then
            TN5250_MSYS2_ROOT=${_candidate}
            return 0
        fi
    done
    TN5250_MSYS2_ROOT=""
}

tn5250_msys2_sfx_url() {
    command -v curl >/dev/null 2>&1 || out_die "curl is required to download MSYS2."
    local _index=$(curl -fsSL --retry 5 --retry-delay 2 "https://repo.msys2.org/distrib/x86_64/") \
        || out_die "Could not read the MSYS2 download index."
    local _name=$(printf '%s\n' "${_index}" | grep -oE 'msys2-base-x86_64-[0-9]{8}\.sfx\.exe' | sort -u | tail -n 1)
    [ -n "${_name}" ] || out_die "No msys2-base-x86_64-*.sfx.exe listed at the MSYS2 index."
    printf '%s%s\n' "https://repo.msys2.org/distrib/x86_64/" "${_name}"
}

tn5250_install_msys2() {
    local _parent=$(dirname "${TN5250_MSYS2_ROOT}")
    mkdir -p "${_parent}" "${HOME}/.cache/tn5250" || out_die "Cannot create the MSYS2 cache."
    local _url=$(tn5250_msys2_sfx_url)
    local _sfx="${HOME}/.cache/tn5250/$(basename "${_url}")"
    local _bytes=0
    if [ -s "${_sfx}" ]; then
        _bytes=$(wc -c < "${_sfx}" | tr -d ' ')
    fi
    if [ ! -s "${_sfx}" ] || [ "${_bytes}" -lt 1000000 ]; then
        out_info "Downloading MSYS2 base environment"
        out_info "${_url}"
        rm -f "${_sfx}" "${_sfx}.partial"
        curl -fL --retry 5 --retry-delay 2 -o "${_sfx}.partial" "${_url}" || out_die "MSYS2 download failed."
        mv -f "${_sfx}.partial" "${_sfx}"
        _bytes=$(wc -c < "${_sfx}" | tr -d ' ')
    fi
    if [ "${_bytes}" -lt 1000000 ]; then
        out_die "MSYS2 download looks incomplete: ${_sfx}"
    fi
    out_info "Extracting MSYS2 into ${TN5250_MSYS2_ROOT}"
    MSYS_NO_PATHCONV=1 "$(cygpath -u "${_sfx}")" -y "-o$(cygpath -w "${_parent}")" || out_die "MSYS2 extract failed."
    [ -x "${TN5250_MSYS2_ROOT}/usr/bin/bash.exe" ] || out_die "MSYS2 extract did not produce ${TN5250_MSYS2_ROOT}"
}

tn5250_ensure_msys2_packages() {
    local _pkgs="mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-cmake mingw-w64-ucrt-x86_64-ninja mingw-w64-ucrt-x86_64-openssl mingw-w64-ucrt-x86_64-pkgconf"
    out_info "Updating MSYS2 packages"
    tn5250_msys2_bash "${TN5250_MSYS2_ROOT}" "pacman -Syu --noconfirm" || true
    tn5250_msys2_bash "${TN5250_MSYS2_ROOT}" "pacman -Syu --noconfirm" || true
    out_info "Installing the UCRT64 build tools"
    if ! tn5250_msys2_bash "${TN5250_MSYS2_ROOT}" "pacman -S --needed --noconfirm ${_pkgs}"; then
        out_info "Initializing pacman keys and retrying the toolchain install"
        tn5250_msys2_bash "${TN5250_MSYS2_ROOT}" "pacman-key --init && pacman-key --populate msys2 && pacman -S --needed --noconfirm ${_pkgs}" || out_die "UCRT64 package install failed."
    fi
    [ -x "${TN5250_MSYS2_ROOT}/ucrt64/bin/gcc.exe" ] || out_die "gcc was not installed under ${TN5250_MSYS2_ROOT}/ucrt64"
    [ -x "${TN5250_MSYS2_ROOT}/ucrt64/bin/cmake.exe" ] || out_die "cmake was not installed under ${TN5250_MSYS2_ROOT}/ucrt64"
    [ -x "${TN5250_MSYS2_ROOT}/ucrt64/bin/ninja.exe" ] || out_die "ninja was not installed under ${TN5250_MSYS2_ROOT}/ucrt64"
    TN5250_TOOL_BIN="${TN5250_MSYS2_ROOT}/ucrt64/bin"
}

tn5250_ensure_toolchain() {
    tn5250_find_msys2
    if [ -z "${TN5250_MSYS2_ROOT}" ] && command -v gcc >/dev/null 2>&1 && command -v cmake >/dev/null 2>&1; then
        out_info "Using gcc and cmake already on PATH"
        TN5250_TOOL_BIN=""
        command -v ninja >/dev/null 2>&1 || command -v mingw32-make >/dev/null 2>&1 || \
            out_die "A generator is missing. Install ninja or mingw32-make, or rerun so setup can install MSYS2."
        return 0
    fi
    if [ -z "${TN5250_MSYS2_ROOT}" ]; then
        TN5250_MSYS2_ROOT="${HOME}/.local/opt/msys64"
        tn5250_install_msys2
    else
        out_info "Using MSYS2 at ${TN5250_MSYS2_ROOT}"
    fi
    if [ ! -x "${TN5250_MSYS2_ROOT}/ucrt64/bin/gcc.exe" ] || [ ! -x "${TN5250_MSYS2_ROOT}/ucrt64/bin/cmake.exe" ] || [ ! -x "${TN5250_MSYS2_ROOT}/ucrt64/bin/ninja.exe" ]; then
        tn5250_ensure_msys2_packages
    else
        TN5250_TOOL_BIN="${TN5250_MSYS2_ROOT}/ucrt64/bin"
        out_info "UCRT64 toolchain is already present"
    fi
}

tn5250_copy_runtime_dlls() {
    local _exe=$1
    local _dest=$2
    local _bin=${3:-}
    local _objdump=""
    if [ -z "${_bin}" ]; then
        local _gcc_path=$(command -v gcc || true)
        if [ -n "${_gcc_path}" ]; then
            _bin=$(dirname "${_gcc_path}")
        fi
    fi
    if [ -n "${_bin}" ] && [ -x "${_bin}/objdump.exe" ]; then
        _objdump="${_bin}/objdump.exe"
    elif command -v objdump >/dev/null 2>&1; then
        _objdump=$(command -v objdump)
    else
        out_warn "objdump is unavailable; runtime DLLs were not copied"
        return 0
    fi
    local _list=$(mktemp) || out_die "Cannot list runtime DLLs."
    "${_objdump}" -p "${_exe}" | awk '/DLL Name:/{print $3}' > "${_list}" || true
    while IFS= read -r _dll; do
        local _dll=$(printf '%s' "${_dll}" | tr -d '\r')
        [ -n "${_dll}" ] || continue
        if [ -n "${_bin}" ] && [ -f "${_bin}/${_dll}" ]; then
            cp -f "${_bin}/${_dll}" "${_dest}/"
        fi
    done < "${_list}"
    rm -f "${_list}"
}

tn5250_build_windows() {
    local _src=$1
    local _build=$2
    local _dest=$3
    local _path_prefix=${PATH}
    if [ -n "${TN5250_TOOL_BIN:-}" ]; then
        _path_prefix="$(cygpath -u "${TN5250_TOOL_BIN}"):${PATH}"
    fi
    if [ -n "${TN5250_TOOL_BIN:-}" ] && [ -x "${TN5250_TOOL_BIN}/ninja.exe" ]; then
        local _gen="Ninja"
    elif PATH="${_path_prefix}" command -v ninja >/dev/null 2>&1; then
        _gen="Ninja"
    elif PATH="${_path_prefix}" command -v mingw32-make >/dev/null 2>&1; then
        _gen="MinGW Makefiles"
    else
        out_die "Could not find ninja or mingw32-make."
    fi
    local _src_m=$(cygpath -m "${_src}")
    local _build_m=$(cygpath -m "${_build}")
    local _prefix_m=""
    if [ -n "${TN5250_TOOL_BIN:-}" ]; then
        _prefix_m=$(cygpath -m "${TN5250_TOOL_BIN}/..")
    fi
    local _cmake=$(PATH="${_path_prefix}" command -v cmake) || out_die "cmake was not found."
    out_info "Configuring with ${_gen}"
    if [ -n "${_prefix_m}" ]; then
        PATH="${_path_prefix}" MSYS_NO_PATHCONV=1 "${_cmake}" -G "${_gen}" -S "${_src_m}" -B "${_build_m}" -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH="${_prefix_m}" \
            || out_die "CMake configure failed."
    else
        PATH="${_path_prefix}" MSYS_NO_PATHCONV=1 "${_cmake}" -G "${_gen}" -S "${_src_m}" -B "${_build_m}" -DCMAKE_BUILD_TYPE=Release \
            || out_die "CMake configure failed."
    fi
    out_info "Building"
    PATH="${_path_prefix}" MSYS_NO_PATHCONV=1 "${_cmake}" --build "${_build_m}" --parallel "${TN5250_JOBS}" \
        || out_die "CMake build failed."
    mkdir -p "${_dest}" || out_die "Cannot create ${_dest}."
    local _list=$(mktemp) || out_die "Cannot list build outputs."
    find "${_build}" -type f \( -name 'tn5250.exe' -o -name 'lp5250d.exe' -o -name 'dftmap.exe' \) ! -path '*/CMakeFiles/*' > "${_list}"
    while IFS= read -r _exe; do
        [ -n "${_exe}" ] || continue
        local _base=$(basename "${_exe}")
        cp -f "${_exe}" "${_dest}/${_base}"
        tn5250_copy_runtime_dlls "${_dest}/${_base}" "${_dest}" "${TN5250_TOOL_BIN:-}"
    done < "${_list}"
    rm -f "${_list}"
    local _name
    for _name in tn5250.exe lp5250d.exe dftmap.exe; do
        [ -f "${_dest}/${_name}" ] || out_die "Build finished without producing ${_name}"
    done
    git -C "${_src}" rev-parse HEAD > "${_dest}/REVISION"
    printf '%s\n' "${TN5250_REF}" > "${_dest}/REF"
    tn5250_write_connect_fix "${_dest}"
}

tn5250_setup_windows() {
    command -v git >/dev/null 2>&1 || out_die "git is required."
    TN5250_PREFIX=$(cygpath -u "${TN5250_PREFIX}")
    [ -n "${TN5250_PREFIX}" ] || out_die "The install prefix is empty."
    tn5250_require_jobs
    TN5250_APP_DIR="${TN5250_PREFIX}/opt/tn5250"
    local _cache=$(tn5250_cache_root)
    local _src="${_cache}/src"
    local _build="${_cache}/build"
    out_info "Installing tn5250 ${TN5250_REF} for Git Bash"
    out_info "Prefix: ${TN5250_PREFIX}"
    tn5250_ensure_toolchain
    tn5250_fetch_source "${_src}"
    out_info "Applying the connect fix"
    tn5250_apply_connect_fix "${_src}"
    out_info "Applying Win32 fixes for GCC 14+"
    tn5250_apply_win32_fixes "${_src}"
    local _sha=$(git -C "${_src}" rev-parse HEAD)
    if [ "${TN5250_FORCE}" -eq 0 ] && [ -f "${TN5250_APP_DIR}/tn5250.exe" ] && [ -f "${TN5250_APP_DIR}/REF" ] && [ -f "${TN5250_APP_DIR}/REVISION" ] && tn5250_payload_has_connect_fix; then
        local _have_ref=$(tn5250_payload_ref)
        local _have_rev=$(tn5250_payload_rev)
        if [ "${_have_ref}" = "${TN5250_REF}" ] && [ "${_have_rev}" = "${_sha}" ]; then
            out_info "tn5250 ${TN5250_REF} (${_sha}) is already installed"
            tn5250_install_cli
            out_info "Run: tn5250 HOST"
            return 0
        fi
    fi
    rm -rf "${_build}"
    tn5250_build_windows "${_src}" "${_build}" "${TN5250_APP_DIR}"
    tn5250_install_cli
    out_info "Installed $(tn5250_payload_ref) ($(tn5250_payload_rev))"
    out_info "Programs: ${TN5250_APP_DIR}"
    out_info "Commands: tn5250, lp5250d, dftmap"
    out_info "Installer remains: ${APP_NAME}"
    out_info "Open a session with: tn5250 HOST"
}

# =============================================================================
# util_sudo() - Only in-tool sudo call site
# =============================================================================
#
# GENERAL PURPOSE:
# Runs a package-manager command. When this process is already root, the
# command runs directly. Otherwise password sudo is used on an open terminal.
# Git, cmake, make, and ninja are not passed here.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: no sudo -n. The studied package path is not NOPASSWD.
# - Intentional: one wrap owns every in-tool sudo.
# - Anti-fragile: an already-root process does not call sudo.
# - Over-protect: a closed terminal or --json stops instead of waiting.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
util_sudo() {
    : "${TTY:=0}"
    : "${TTY_OPEN:=0}"
    : "${JSON:=0}"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        "$@"
        return $?
    fi
    if ! command -v sudo >/dev/null 2>&1; then
        return 127
    fi
    if [ "${JSON}" -eq 1 ] || [ "${TTY}" -eq 0 ] || [ "${TTY_OPEN}" -eq 0 ]; then
        return 126
    fi
    sudo "$@" </dev/tty
    return $?
}

# =============================================================================
# tn5250_run_elevated() - Package command through util_sudo, with a clear stop
# =============================================================================
#
# GENERAL PURPOSE:
# Runs one package-manager argv. On success it returns. On failure it tells
# the person what is missing and what to run next. It does not start git.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: a missing sudo or a closed terminal does not hang.
# - Intentional: the message names the packages.
# - Anti-fragile: the compile is not started after a failed install.
# - Over-protect: this helper is the only caller of util_sudo.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_run_elevated() {
    : "${APP_NAME:=tn5250-cli}"
    local _shown=$1
    shift
    util_sudo "$@"
    local _rc=$?
    if [ "${_rc}" -eq 0 ]; then
        return 0
    fi
    if [ "${_rc}" -eq 127 ]; then
        out_die "sudo is not available, so these compiler packages cannot be installed: ${_shown}. Next: install sudo, or install those packages as the administrator, then run ${APP_NAME} setup again."
    fi
    if [ "${_rc}" -eq 126 ]; then
        out_die "These compiler packages are missing: ${_shown}. This run cannot ask for your password, so setup stopped before git and the compile. Next: open a terminal and run ${APP_NAME} setup, or install those packages yourself and run it again."
    fi
    out_die "Installing these compiler packages failed: ${_shown}. Git and the compile were not started. Next: install them with the system package manager, then run ${APP_NAME} setup again."
}

# =============================================================================
# tn5250_unix_gaps() - Non-sudo probe of the Unix compile tools
# =============================================================================
#
# GENERAL PURPOSE:
# Prints a space-separated list of missing tool tokens. An empty line means
# the compile tools are already present and sudo must not run.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: the probe never calls sudo.
# - Intentional: each token maps to one package family later.
# - Anti-fragile: a present toolchain produces an empty list.
# - Over-protect: CMake older than 3.12 counts as missing.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
# - docs/requirements/requirement-debian.md
# - docs/requirements/requirement-ubuntu.md
# - docs/requirements/requirement-other-linux.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_unix_gaps() {
    : "${HOME:=/tmp}"
    local _gaps=""
    if ! command -v gcc >/dev/null 2>&1; then
        _gaps="${_gaps} gcc"
    else
        local _header_gap=0
        local _c=""
        if command -v mktemp >/dev/null 2>&1; then
            _c=$(mktemp) || _c=""
        fi
        if [ -n "${_c}" ]; then
            printf '%s\n' 'int main(void){return 0;}' > "${_c}"
            if ! gcc -c -x c "${_c}" -o "${_c}.o" >/dev/null 2>&1; then
                _header_gap=1
            fi
            rm -f "${_c}" "${_c}.o"
        else
            if [ ! -f /usr/include/stdio.h ]; then
                _header_gap=1
            fi
        fi
        if [ "${_header_gap}" -eq 1 ]; then
            _gaps="${_gaps} c-headers"
        fi
    fi
    if ! command -v git >/dev/null 2>&1; then
        _gaps="${_gaps} git"
    fi
    if ! command -v cmake >/dev/null 2>&1; then
        _gaps="${_gaps} cmake"
    else
        local _line _maj _min
        _line=$(cmake --version 2>/dev/null | head -n 1)
        _maj=$(printf '%s\n' "${_line}" | sed -n 's/.* \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1/p')
        _min=$(printf '%s\n' "${_line}" | sed -n 's/.* \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\2/p')
        if [ -z "${_maj}" ] || [ -z "${_min}" ]; then
            _gaps="${_gaps} cmake"
        else
            if [ "${_maj}" -lt 3 ]; then
                _gaps="${_gaps} cmake"
            else
                if [ "${_maj}" -eq 3 ] && [ "${_min}" -lt 12 ]; then
                    _gaps="${_gaps} cmake"
                fi
            fi
        fi
    fi
    if ! command -v pkg-config >/dev/null 2>&1 && ! command -v pkgconf >/dev/null 2>&1; then
        _gaps="${_gaps} pkg-config"
    fi
    if [ ! -f /usr/include/ncurses.h ] && [ ! -f /usr/include/ncurses/ncurses.h ]; then
        _gaps="${_gaps} ncurses"
    fi
    if [ ! -f /usr/include/openssl/ssl.h ]; then
        _gaps="${_gaps} openssl"
    fi
    if ! command -v ninja >/dev/null 2>&1 && ! command -v make >/dev/null 2>&1; then
        _gaps="${_gaps} generator"
    fi
    if [ ! -d /usr/share/terminfo ] && [ ! -d /lib/terminfo ] && [ ! -d /usr/lib/terminfo ] && [ ! -d /etc/terminfo ]; then
        _gaps="${_gaps} terminfo"
    fi
    printf '%s\n' "${_gaps# }"
}

# =============================================================================
# tn5250_remember_pkg() - Keep one package name in the install list
# =============================================================================
#
# GENERAL PURPOSE:
# Adds a package name once. A repeated gap must not ask for the same package twice.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: an empty list stays empty.
# - Intentional: the name is the distribution package, not the tool token.
# - Anti-fragile: a second request for the same name is a no-op.
# - Over-protect: this helper does not call a package manager.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_remember_pkg() {
    local _name=$1
    case " ${TN5250_PKG_WORDS:-} " in
        *" ${_name} "*) ;;
        *) TN5250_PKG_WORDS="${TN5250_PKG_WORDS:-} ${_name}" ;;
    esac
}

# =============================================================================
# tn5250_packages_for_gaps() - Map missing tool tokens to package names
# =============================================================================
#
# GENERAL PURPOSE:
# Turns the probe tokens into the package names for one family. The names are
# the ones recorded on the sudo-command requirement.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: an unknown token adds nothing.
# - Intentional: each family has its own names.
# - Anti-fragile: gcc and the C headers can share one package.
# - Over-protect: this helper does not install anything.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_packages_for_gaps() {
    local _fam=$1
    shift
    TN5250_PKG_WORDS=""
    local _gap
    for _gap in "$@"; do
        case "${_fam}:${_gap}" in
            apt:gcc) tn5250_remember_pkg gcc; tn5250_remember_pkg libc6-dev ;;
            apt:c-headers) tn5250_remember_pkg libc6-dev ;;
            apt:cmake) tn5250_remember_pkg cmake ;;
            apt:pkg-config) tn5250_remember_pkg pkgconf ;;
            apt:ncurses) tn5250_remember_pkg libncurses-dev ;;
            apt:openssl) tn5250_remember_pkg libssl-dev ;;
            apt:generator) tn5250_remember_pkg ninja-build ;;
            apt:terminfo) tn5250_remember_pkg ncurses-base ;;
            apt:git) tn5250_remember_pkg git ;;
            apk:gcc|apk:c-headers) tn5250_remember_pkg build-base ;;
            apk:cmake) tn5250_remember_pkg cmake ;;
            apk:pkg-config) tn5250_remember_pkg pkgconf ;;
            apk:ncurses) tn5250_remember_pkg ncurses-dev ;;
            apk:openssl) tn5250_remember_pkg openssl-dev ;;
            apk:generator) tn5250_remember_pkg ninja ;;
            apk:terminfo) tn5250_remember_pkg ncurses-terminfo-base ;;
            apk:git) tn5250_remember_pkg git ;;
            dnf:gcc) tn5250_remember_pkg gcc ;;
            dnf:c-headers) tn5250_remember_pkg glibc-devel ;;
            dnf:cmake) tn5250_remember_pkg cmake ;;
            dnf:pkg-config) tn5250_remember_pkg pkgconf-pkg-config ;;
            dnf:ncurses) tn5250_remember_pkg ncurses-devel ;;
            dnf:openssl) tn5250_remember_pkg openssl-devel ;;
            dnf:generator) tn5250_remember_pkg ninja-build ;;
            dnf:terminfo) tn5250_remember_pkg ncurses ;;
            dnf:git) tn5250_remember_pkg git ;;
            pacman:gcc) tn5250_remember_pkg gcc ;;
            pacman:c-headers) tn5250_remember_pkg glibc ;;
            pacman:cmake) tn5250_remember_pkg cmake ;;
            pacman:pkg-config) tn5250_remember_pkg pkgconf ;;
            pacman:ncurses|pacman:terminfo) tn5250_remember_pkg ncurses ;;
            pacman:openssl) tn5250_remember_pkg openssl ;;
            pacman:generator) tn5250_remember_pkg ninja ;;
            pacman:git) tn5250_remember_pkg git ;;
            zypper:gcc) tn5250_remember_pkg gcc ;;
            zypper:c-headers) tn5250_remember_pkg glibc-devel ;;
            zypper:cmake) tn5250_remember_pkg cmake ;;
            zypper:pkg-config) tn5250_remember_pkg pkgconf ;;
            zypper:ncurses|zypper:terminfo) tn5250_remember_pkg ncurses-devel ;;
            zypper:openssl) tn5250_remember_pkg libopenssl-devel ;;
            zypper:generator) tn5250_remember_pkg ninja ;;
            zypper:git) tn5250_remember_pkg git ;;
        esac
    done
    printf '%s\n' "${TN5250_PKG_WORDS# }"
}

# =============================================================================
# tn5250_package_family() - Choose apt, apk, dnf, pacman, or zypper
# =============================================================================
#
# GENERAL PURPOSE:
# Prints the family the caller forced, or the first of those package managers
# that is on PATH. An empty line means setup must stop and name the tools.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: a forced family is not replaced by a later guess.
# - Intentional: the search order is apt-get, apk, dnf, pacman, then zypper.
# - Anti-fragile: a missing manager is an empty result, not a made-up name.
# - Over-protect: Termux pkg is not a family.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
# - docs/requirements/requirement-other-linux.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_package_family() {
    local _asked=${1:-}
    if [ -n "${_asked}" ]; then
        printf '%s\n' "${_asked}"
        return 0
    fi
    if command -v apt-get >/dev/null 2>&1; then
        printf '%s\n' apt
        return 0
    fi
    if command -v apk >/dev/null 2>&1; then
        printf '%s\n' apk
        return 0
    fi
    if command -v dnf >/dev/null 2>&1; then
        printf '%s\n' dnf
        return 0
    fi
    if command -v pacman >/dev/null 2>&1; then
        printf '%s\n' pacman
        return 0
    fi
    if command -v zypper >/dev/null 2>&1; then
        printf '%s\n' zypper
        return 0
    fi
    printf '%s\n' ""
}

# =============================================================================
# tn5250_unix_ensure_packages() - Install only the missing compiler packages
# =============================================================================
#
# GENERAL PURPOSE:
# When the probe is empty, return without sudo. Otherwise install the missing
# packages for the named family, or for the package manager found on PATH.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: sudo is skipped when the tools are already present.
# - Intentional: only the missing packages are requested.
# - Anti-fragile: a second probe after install must come back empty.
# - Over-protect: git is not started from this function.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
# - docs/requirements/requirement-debian.md
# - docs/requirements/requirement-ubuntu.md
# - docs/requirements/requirement-other-linux.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_unix_ensure_packages() {
    : "${APP_NAME:=tn5250-cli}"
    local _asked=${1:-}
    local _gaps
    _gaps=$(tn5250_unix_gaps)
    if [ -z "${_gaps}" ]; then
        return 0
    fi
    local _fam
    _fam=$(tn5250_package_family "${_asked}")
    if [ -z "${_fam}" ]; then
        out_die "These tools are missing: ${_gaps}. This host has none of apt-get, apk, dnf, pacman, or zypper, so setup cannot install them. Next: install the packages that provide those tools, then run ${APP_NAME} setup again."
    fi
    local _pkgs
    _pkgs=$(tn5250_packages_for_gaps "${_fam}" ${_gaps})
    if [ -z "${_pkgs}" ]; then
        out_die "These tools are missing: ${_gaps}. Setup has no package names for them on this host. Next: install the packages that provide those tools, then run ${APP_NAME} setup again."
    fi
    out_info "Installing missing compiler packages: ${_pkgs}"
    case "${_fam}" in
        apt)
            tn5250_run_elevated "${_pkgs}" apt-get update
            tn5250_run_elevated "${_pkgs}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ${_pkgs}
            ;;
        apk)
            tn5250_run_elevated "${_pkgs}" apk add --no-cache ${_pkgs}
            ;;
        dnf)
            tn5250_run_elevated "${_pkgs}" dnf install -y ${_pkgs}
            ;;
        pacman)
            tn5250_run_elevated "${_pkgs}" pacman -S --noconfirm --needed ${_pkgs}
            ;;
        zypper)
            tn5250_run_elevated "${_pkgs}" zypper --non-interactive install ${_pkgs}
            ;;
        *)
            out_die "These tools are missing: ${_gaps}. Setup does not know how to install them with ${_fam}. Next: install the packages that provide those tools, then run ${APP_NAME} setup again."
            ;;
    esac
    _gaps=$(tn5250_unix_gaps)
    if [ -n "${_gaps}" ]; then
        out_die "The package install finished and these tools are still missing: ${_gaps}. Git and the compile were not started. Next: install the packages that provide them, then run ${APP_NAME} setup again."
    fi
}

# =============================================================================
# tn5250_continue_as_login() - One setup verb for the user and for sudo
# =============================================================================
#
# GENERAL PURPOSE:
# Mixed elevated sudo model. A normal user stays as that user. sudo inside
# setup is only the missing-package install. When setup is already root
# because sudo started it, return to that person before git and the compile.
# That return is recovery. Help does not tell the person to start that way.
# A root login with no such person stops before git.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: git is not reached while the process is root.
# - Intentional: the same setup verb serves both launches.
# - Anti-fragile: TN5250_AS_LOGIN stops a second switch.
# - Over-protect: a failed switch does not compile as root.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-shell-sudo-command.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_continue_as_login() {
    : "${TN5250_AS_LOGIN:=0}"
    : "${TN5250_PREFIX:=}"
    : "${TN5250_REF:=v0.18.0}"
    : "${TN5250_FORCE:=0}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${DEBUG:=0}"
    : "${APP_NAME:=tn5250-cli}"
    : "${TN5250_MSYS2_ROOT:=}"
    if [ "${TN5250_AS_LOGIN}" -eq 1 ]; then
        return 0
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        return 0
    fi
    if [ -z "${SUDO_USER:-}" ] || [ "${SUDO_USER}" = "root" ]; then
        out_die "setup is running as root, so git and the compile would belong to root. Next: run ${APP_NAME} setup as your user. The same command installs missing compiler packages and asks for the administrator password only for that install."
    fi
    local _home
    _home=$(getent passwd "${SUDO_USER}" 2>/dev/null | awk -F: 'NR==1 { print $6 }')
    if [ -z "${_home}" ] || [ ! -d "${_home}" ]; then
        out_die "setup is running as root, and the home of the person who started it could not be read. Git and the compile would belong to root. Next: run ${APP_NAME} setup as that person."
    fi
    if ! command -v runuser >/dev/null 2>&1; then
        out_die "setup is running as root, so git and the compile would belong to root. Next: run ${APP_NAME} setup as the person who should own the build."
    fi
    out_info "Continuing git and the compile as the user who started setup"
    set -- setup --prefix "${TN5250_PREFIX}" --ref "${TN5250_REF}"
    if [ -n "${TN5250_JOBS:-}" ]; then
        set -- "$@" --jobs "${TN5250_JOBS}"
    fi
    if [ -n "${TN5250_MSYS2_ROOT}" ]; then
        set -- "$@" --msys2-root "${TN5250_MSYS2_ROOT}"
    fi
    if [ "${TN5250_FORCE}" -eq 1 ]; then
        set -- "$@" --force
    fi
    if [ "${JSON}" -eq 1 ]; then
        set -- "$@" --json
    fi
    if [ "${QUIET}" -eq 1 ] && [ "${JSON}" -eq 0 ]; then
        set -- "$@" --quiet
    fi
    if [ "${DEBUG}" -eq 1 ]; then
        set -- "$@" --debug
    fi
    exec runuser -u "${SUDO_USER}" -- env \
        -u SUDO_USER -u SUDO_UID -u SUDO_GID -u SUDO_COMMAND \
        HOME="${_home}" \
        USER="${SUDO_USER}" \
        LOGNAME="${SUDO_USER}" \
        TN5250_AS_LOGIN=1 \
        XDG_CACHE_HOME="${_home}/.cache" \
        "$0" "$@"
    out_die "setup could not return to the person who started it, so git and the compile were not started. Next: run ${APP_NAME} setup as that person."
}

tn5250_build_debian() {
    local _src=$1
    local _build=$2
    local _dest=$3
    local _gen
    if command -v ninja >/dev/null 2>&1; then
        _gen="Ninja"
    else
        _gen="Unix Makefiles"
    fi
    out_info "Configuring with ${_gen}"
    cmake -G "${_gen}" -S "${_src}" -B "${_build}" -DCMAKE_BUILD_TYPE=Release || out_die "CMake configure failed."
    out_info "Building"
    cmake --build "${_build}" --parallel "${TN5250_JOBS}" || out_die "CMake build failed."
    mkdir -p "${_dest}" || out_die "Cannot create the payload directory."
    local _names="tn5250"
    if [ "${TN5250_SYSLOG_OPTIONAL:-0}" -eq 0 ] || [ -f /usr/include/syslog.h ]; then
        _names="tn5250 lp5250d scs2ascii scs2pdf scs2ps"
    fi
    local _name
    for _name in ${_names}; do
        local _exe=$(find "${_build}" -type f -name "${_name}" ! -path '*/CMakeFiles/*' | head -n 1)
        [ -n "${_exe}" ] && [ -f "${_exe}" ] || out_die "Build finished without producing ${_name}"
        cp -f "${_exe}" "${_dest}/${_name}" || out_die "Cannot copy ${_name}."
    done
    git -C "${_src}" rev-parse HEAD > "${_dest}/REVISION"
    printf '%s\n' "${TN5250_REF}" > "${_dest}/REF"
    tn5250_write_connect_fix "${_dest}"
}

# =============================================================================
# tn5250_setup_unix() - Unix setup after the package probe
# =============================================================================
#
# GENERAL PURPOSE:
# Installs missing compiler packages, then fetches and compiles as the
# person who started setup. Debian and Ubuntu pass apt. Other Linux detects
# the package manager. The four syslog programs are optional only on other Linux.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: --msys2-root is rejected here.
# - Intentional: one Unix build path for Debian, Ubuntu, and other Linux.
# - Anti-fragile: an already installed revision returns without a rebuild.
# - Over-protect: the Windows source patch is not applied.
#
# ALIGNMENT (live requirements only):
# - docs/requirements/requirement-debian.md
# - docs/requirements/requirement-ubuntu.md
# - docs/requirements/requirement-other-linux.md
# - docs/requirements/requirement-shell-sudo-command.md
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
#
# Last updated: 2026-10-07
# =============================================================================
tn5250_setup_unix() {
    local _label=$1
    local _family=$2
    local _syslog_optional=$3
    : "${TN5250_SYSLOG_OPTIONAL:=0}"
    if [ -n "${TN5250_MSYS2_ROOT:-}" ]; then
        out_die "--msys2-root is only for the Git Bash build."
    fi
    [ -n "${TN5250_PREFIX}" ] || out_die "The install prefix is empty."
    tn5250_require_jobs
    tn5250_unix_ensure_packages "${_family}"
    tn5250_continue_as_login
    TN5250_SYSLOG_OPTIONAL=${_syslog_optional}
    TN5250_APP_DIR="${TN5250_PREFIX}/opt/tn5250"
    local _cache=$(tn5250_cache_root)
    local _src="${_cache}/src"
    local _build="${_cache}/build"
    out_info "Installing tn5250 ${TN5250_REF} for ${_label}"
    out_info "Prefix: ${TN5250_PREFIX}"
    tn5250_fetch_source "${_src}"
    out_info "Applying the connect fix"
    tn5250_apply_connect_fix "${_src}"
    local _sha=$(git -C "${_src}" rev-parse HEAD)
    if [ "${TN5250_FORCE}" -eq 0 ] && [ -f "${TN5250_APP_DIR}/tn5250" ] && [ -f "${TN5250_APP_DIR}/REF" ] && [ -f "${TN5250_APP_DIR}/REVISION" ] && tn5250_payload_has_connect_fix; then
        local _have_ref=$(tn5250_payload_ref)
        local _have_rev=$(tn5250_payload_rev)
        if [ "${_have_ref}" = "${TN5250_REF}" ] && [ "${_have_rev}" = "${_sha}" ]; then
            out_info "tn5250 ${TN5250_REF} (${_sha}) is already installed"
            tn5250_install_cli
            out_info "Run: tn5250 HOST"
            return 0
        fi
    fi
    rm -rf "${_build}"
    tn5250_build_debian "${_src}" "${_build}" "${TN5250_APP_DIR}"
    tn5250_install_cli
    out_info "Installed $(tn5250_payload_ref) ($(tn5250_payload_rev))"
    out_info "Programs: ${TN5250_APP_DIR}"
    out_info "Installer remains: ${APP_NAME}"
    out_info "Open a session with: tn5250 HOST"
}

tn5250_setup() {
    : "${HOME:=/tmp}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${DEBUG:=0}"
    local _prefix_set=0
    if [ -n "${TN5250_PREFIX:-}" ]; then
        _prefix_set=1
    fi
    TN5250_REF=${TN5250_REF:-${TN5250_REF_DEFAULT}}
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)
                tn5250_setup_help
                return 0
                ;;
            --prefix)
                [ $# -ge 2 ] || out_die "--prefix needs a directory"
                TN5250_PREFIX=$2
                _prefix_set=1
                shift 2
                ;;
            --prefix=*)
                TN5250_PREFIX=${1#*=}
                _prefix_set=1
                shift
                ;;
            --ref)
                [ $# -ge 2 ] || out_die "--ref needs a tag or branch"
                TN5250_REF=$2
                shift 2
                ;;
            --ref=*)
                TN5250_REF=${1#*=}
                shift
                ;;
            --msys2-root)
                [ $# -ge 2 ] || out_die "--msys2-root needs a directory"
                TN5250_MSYS2_ROOT=$2
                shift 2
                ;;
            --msys2-root=*)
                TN5250_MSYS2_ROOT=${1#*=}
                shift
                ;;
            --jobs)
                [ $# -ge 2 ] || out_die "--jobs needs a number"
                TN5250_JOBS=$2
                shift 2
                ;;
            --jobs=*)
                TN5250_JOBS=${1#*=}
                shift
                ;;
            --force)
                FORCE=1
                shift
                ;;
            --quiet|-q)
                QUIET=1
                shift
                ;;
            --json)
                JSON=1
                QUIET=1
                shift
                ;;
            --debug)
                DEBUG=1
                shift
                ;;
            *)
                out_die "Unknown option: $1 (try: ${APP_NAME} setup --help)"
                ;;
        esac
    done
    if [ "${FORCE:-0}" -eq 1 ]; then
        TN5250_FORCE=1
    else
        TN5250_FORCE=0
    fi
    if [ "${_prefix_set}" -eq 0 ]; then
        local _prefix_home="${HOME}"
        if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "${SUDO_USER}" != "root" ]; then
            local _pw
            _pw=$(getent passwd "${SUDO_USER}" 2>/dev/null | awk -F: 'NR==1 { print $6 }')
            if [ -n "${_pw}" ] && [ -d "${_pw}" ]; then
                _prefix_home="${_pw}"
            fi
        fi
        TN5250_PREFIX="${_prefix_home}/.local"
    fi
    local _plat=$(tn5250_detect_platform)
    case "${_plat}" in
        windows)
            tn5250_continue_as_login
            tn5250_setup_windows
            ;;
        debian) tn5250_setup_unix "Debian" "apt" 0 ;;
        ubuntu) tn5250_setup_unix "Ubuntu" "apt" 0 ;;
        other-linux) tn5250_setup_unix "Linux" "" 1 ;;
        *) tn5250_refuse_host "setup" "${_plat}" ;;
    esac
}

tn5250_refuse_host() {
    local _what=$1
    local _plat=$2
    : "${APP_NAME:=tn5250-cli}"
    case "${_plat}" in
        termux)
            out_die "${_what} does not run under Termux. Next: use Debian 12 or 13, Ubuntu 22.04, 24.04, or 26.04, or another Linux."
            ;;
        debian-mismatch)
            out_die "This Debian release mixes version 12 or 13 with the wrong codename. ${_what} will not treat that as another Linux. Next: use Debian 12 bookworm or Debian 13 trixie."
            ;;
        ubuntu-mismatch)
            out_die "This Ubuntu release mixes 22.04, 24.04, or 26.04 with the wrong codename. ${_what} will not treat that as another Linux. Next: use Ubuntu 22.04 jammy, 24.04 noble, or 26.04 resolute."
            ;;
        *)
            out_die "${_what} needs Git Bash on Windows, Debian 12 or 13, Ubuntu 22.04, 24.04, or 26.04, or another Linux. Next: run it on one of those systems."
            ;;
    esac
}

tn5250_launch() {
    local _host=$1
    shift
    local _plat=$(tn5250_detect_platform)
    local _exe=""
    case "${_plat}" in
        windows)
            _exe="$(tn5250_app_dir)/tn5250.exe"
            [ -f "${_exe}" ] || out_die "tn5250 is not installed in this Git Bash yet. Run: ${APP_NAME} setup"
            MSYS_NO_PATHCONV=1
            export MSYS_NO_PATHCONV
            exec "${_exe}" "${_host}" "$@"
            ;;
        debian|ubuntu|other-linux)
            _exe="$(tn5250_app_dir)/tn5250"
            [ -x "${_exe}" ] || [ -f "${_exe}" ] || out_die "tn5250 is not installed yet. Run: ${APP_NAME} setup"
            exec "${_exe}" "${_host}" "$@"
            ;;
        *)
            tn5250_refuse_host "Opening a host" "${_plat}"
            ;;
    esac
}

app_about() {
    # --- Safe Variable Defaults ---
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=tn5250-cli}"
    # Version comes from global SSOT (VERSION="…" hard-assign near top); default only if unset
    : "${VERSION:=1.0.2}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SCRIPT_URL:=}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"

    # Storage (requirement-shell-cli-storage): resolve if main has not yet
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    if [ "${JSON}" -eq 1 ]; then
        # === JSON MODE - Clean, machine-friendly output ===
        local installed="false"
        inst_is_installed && installed="true"

        local global_ver="not found"
        if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
            global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi

        local local_ver="not found"
        if [ -x "${USER_BIN}/${APP_NAME}" ]; then
            local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi

        local current_shell
        current_shell=$(util_get_current_shell)

        local interactive="false"
        [ -t 1 ] && interactive="true"

        local current_user
        current_user="$(id -un 2>/dev/null || echo "unknown")"

        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "${installed}" \
            "global_version" "${global_ver}" \
            "local_version" "${local_ver}" \
            "shell" "${current_shell}" \
            "interactive" "${interactive}" \
            "user" "${current_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "payload_platform" "$(tn5250_detect_platform)" \
            "payload_ref" "$(tn5250_payload_ref)" \
            "payload_revision" "$(tn5250_payload_rev)"
        return 0
    fi

    # === Normal Human-readable Mode ===
    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line

    # Installation status
    if inst_is_installed; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in your PATH."
        if [ -n "${SCRIPT_URL}" ]; then
            out_info "   Recommended: curl -fsSL ${SCRIPT_URL} | sh"
        else
            out_info "   Set SCRIPT_URL to the install script URL, then: curl -fsSL \"\${SCRIPT_URL}\" | sh"
        fi
    fi

    out_empty_line

    # Global vs Local installation details
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${global_ver}"
    else
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   not found"
    fi

    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${local_ver}"
    else
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    not found"
    fi

    out_empty_line

    local current_user
    current_user="$(id -un 2>/dev/null || echo "unknown")"
    out_info "Current user:      ${current_user}"

    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root (global install path available)"
    else
        out_info "Execution context: normal user (Type 0 CLI self-management)"
    fi

    out_empty_line

    local current_shell
    current_shell=$(util_get_current_shell)

    out_info "Current shell:     ${current_shell}"

    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no (non-interactive / scripted mode)"
    fi

    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback config field): ${STORAGE_DIR}"

    # --- DOMAIN_ABOUT_FIELDS (specializee injection) ---
    tn5250_about_human
    # --- end DOMAIN_ABOUT_FIELDS ---

    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help           → Full usage"
    out_info "   ${APP_NAME} self-update    → Update to latest version"
    out_info "   ${APP_NAME} self-uninstall → Clean removal from system"
    out_info "   ${APP_NAME} --json         → Machine-readable output"

    out_empty_line
    out_info "Run '${APP_NAME} help' for complete usage information."
}

